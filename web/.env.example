# ─────────────────────────────────────────────────────────────
# ORYN — environment variables
# Copy to .env.local for local development. Never commit real values.
# Variables marked [platform] are only needed for the ORYN platform
# (/app, /api/v1, worker). The marketing site runs without them.
# ─────────────────────────────────────────────────────────────

# ── Public site ──────────────────────────────────────────────
# Canonical public URL (metadata, sitemap, Open Graph, invitation links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show "Sign in" in the site header (links to /login).
NEXT_PUBLIC_PLATFORM_ENABLED=true
# Optional: external platform URL instead of the built-in /login.
NEXT_PUBLIC_COMMAND_URL=
# Optional public inquiry address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form delivery (Resend). See README → Contact form behavior.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ── Database [platform] ──────────────────────────────────────
# PostgreSQL 15+ with PostGIS 3.4+. Two roles (see README → Database roles):
#   DATABASE_URL        least-privilege app login (member of oryn_app_role,
#                       NO superuser, NO BYPASSRLS) — row-level security applies
#   DATABASE_OWNER_URL  schema owner — migrations and admin CLI only
# Local values match docker-compose.yml.
DATABASE_URL=postgres://oryn_app:oryn_app_dev_only@127.0.0.1:54329/oryn
DATABASE_OWNER_URL=postgres://oryn_owner:oryn_owner_dev_only@127.0.0.1:54329/oryn
DATABASE_POOL_MAX=10
# Integration tests default to the "oryn_test" database on the same server.
# TEST_DATABASE_URL=
# TEST_DATABASE_OWNER_URL=

# ── Authentication [platform] ────────────────────────────────
# At least 32 random characters: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Base URL of this deployment (cookie origin, invitation and reset links).
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call /api/auth (comma-separated). Usually empty.
ORYN_TRUSTED_ORIGINS=
# Reverse proxies (CIDRs, comma-separated) whose X-Forwarded-For entries are trusted
# when finding the client address for sign-in rate limits. Empty: only a single-address
# X-Forwarded-For is used (e.g. Vercel). Set it behind a multi-hop proxy chain.
ORYN_TRUSTED_PROXIES=
# Session lifetime in seconds (default 43200 = 12 h).
ORYN_SESSION_MAX_AGE_SECONDS=43200

# ── Object storage [platform] ────────────────────────────────
# "local" stores files under ORYN_STORAGE_DIR (development). Production refuses
# it unless ORYN_ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true (one server, persistent disk).
# "s3" uses an S3-compatible service with a PRIVATE bucket; objects are written
# with SSE-S3 (ORYN_S3_SSE=AES256, default) unless ORYN_S3_SSE=none.
ORYN_STORAGE_DRIVER=local
ORYN_STORAGE_DIR=./var/storage
ORYN_ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
ORYN_S3_BUCKET=
ORYN_S3_REGION=us-east-1
ORYN_S3_ENDPOINT=
ORYN_S3_ACCESS_KEY_ID=
ORYN_S3_SECRET_ACCESS_KEY=
ORYN_S3_FORCE_PATH_STYLE=false
ORYN_S3_SSE=AES256

# ── Jobs & scheduling [platform] ─────────────────────────────
# Long-running worker: `npm run worker`. Serverless hosts: call
# GET /api/cron/tick every minute with "Authorization: Bearer $ORYN_CRON_SECRET".
ORYN_CRON_SECRET=
ORYN_WORKER_CONCURRENCY=2
ORYN_WORKER_POLL_MS=2000
ORYN_SCHEDULER_INTERVAL_MS=60000
# Worker /healthz and /readyz port (0 = off; the container image uses 8081).
ORYN_WORKER_HEALTH_PORT=0

# ── Deployment safety ────────────────────────────────────────
# Gated integrations verified live in THIS deployment (`npm run oryn:verify -- <id>`).
# In production, email, gdelt, nasa-hls, and ai-summaries stay off unless listed.
ORYN_VERIFIED_INTEGRATIONS=
# Production-mode rehearsal on one machine (docs/DEPLOYMENT.md). Honoured only
# when BETTER_AUTH_URL is a localhost URL; refused otherwise.
ORYN_LOCAL_REHEARSAL=false
# Set per container (web, worker, migrate) and added to every log line as "svc".
ORYN_SERVICE=

# ── Limits [platform] ────────────────────────────────────────
ORYN_MAX_AOI_AREA_KM2=2500
ORYN_MAX_UPLOAD_BYTES=15728640

# ── Data providers [platform] ────────────────────────────────
# Earth Search (Element 84, Sentinel-2 L2A COGs) — no credentials.
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
# Microsoft Planetary Computer (Sentinel-1 RTC, Landsat C2 L2, WorldCover,
# IO LULC) — anonymous SAS tokens; a subscription key raises rate limits.
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
PLANETARY_COMPUTER_SAS_URL=https://planetarycomputer.microsoft.com/api/sas/v1
PLANETARY_COMPUTER_SUBSCRIPTION_KEY=
# Copernicus Data Space Ecosystem — catalog search works without credentials;
# downloads need an OAuth client (not used by ORYN analytics yet).
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# NASA Earthdata (HLS via CMR STAC) — reads require a bearer token.
NASA_CMR_STAC_URL=https://cmr.earthdata.nasa.gov/stac/LPCLOUD
EARTHDATA_TOKEN=
# NOAA/NWS requires a User-Agent that identifies the application and a contact.
NWS_USER_AGENT="ORYN (ops@example.com)"
# Open-Meteo: the free API is licensed for NON-COMMERCIAL use only. In
# production set OPEN_METEO_API_KEY (commercial plan), or leave it unset and
# Open-Meteo stays disabled. OPEN_METEO_ALLOW_NONCOMMERCIAL defaults to true
# only outside production.
OPEN_METEO_API_KEY=
OPEN_METEO_ALLOW_NONCOMMERCIAL=
# GDELT news search (public; ~1 request per 5 s).
GDELT_ENABLED=true
# OpenStreetMap Overpass endpoint (ODbL data).
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Contact address included in provider User-Agent strings.
ORYN_API_CONTACT_EMAIL=

# ── Notifications [platform] ─────────────────────────────────
# Without these, alerts are delivered in-app only and email is reported as
# "not configured"; password reset is unavailable.
ORYN_EMAIL_FROM=
# (RESEND_API_KEY above is shared.)

# ── AI report narratives [platform, optional] ────────────────
# When set, reports can include a narrative that summarizes ONLY the stored
# findings and cites them; otherwise a deterministic template is used.
ANTHROPIC_API_KEY=
ORYN_AI_MODEL=claude-opus-5-5

# ── Operations ───────────────────────────────────────────────
LOG_LEVEL=info
ORYN_APP_VERSION=

# ── Development only (production refuses to start with these set) ────────
# Required for `npm run db:seed` (refuses to run in production; no override).
ORYN_ALLOW_SYNTHETIC_SEED=false
ORYN_DEV_SEED_PASSWORD=
# Used by `npm run oryn:admin -- create` instead of a generated password.
ORYN_ADMIN_PASSWORD=
# Password for `npm run oryn:accounts -- provision-trial|create|reset-password`.
# Prefer passing it for one command (ORYN_PROVISION_PASSWORD='…' npm run …), using the
# interactive prompt, or --generate-password. Never commit a real value.
ORYN_PROVISION_PASSWORD=
