{
  "name": "oryn-website",
  "version": "0.1.0",
  "private": true,
  "description": "ORYN — public website and geospatial intelligence platform.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx scripts/oryn/migrate.ts",
    "db:migrate:status": "tsx scripts/oryn/migrate.ts --status",
    "db:seed": "tsx scripts/oryn/seed.ts",
    "oryn:admin": "tsx scripts/oryn/admin.ts",
    "oryn:accounts": "tsx scripts/oryn/accounts.ts",
    "oryn:verify": "tsx scripts/oryn/verify.ts",
    "oryn:smoke": "tsx scripts/oryn/smoke.ts",
    "worker": "tsx scripts/oryn/worker.ts",
    "build:scripts": "node scripts/build-scripts.mjs",
    "start:worker": "node dist/worker.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@cesium/engine": "26.3.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.10",
    "clsx": "2.1.1",
    "geotiff": "3.0.5",
    "hls.js": "1.7.3",
    "lucide-react": "1.55.0",
    "maplibre-gl": "6.14.0",
    "motion": "14.1.0",
    "next": "16.4.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "proj4": "2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satellite.js": "7.1.0",
    "server-only": "0.0.1",
    "terra-draw": "1.37.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
